{
  "name": "@kagunex/baileys",
  "version": "1.8.2",
  "description": "KaguneX WhatsApp Web client library for Node.js (TypeScript)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && npm run verify"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "whatsapp",
    "baileys",
    "kagunex",
    "websocket",
    "typescript"
  ],
  "author": "KaguneX",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remzzxelipsce/Kagunex-baileys.git"
  },
  "bugs": {
    "url": "https://github.com/remzzxelipsce/Kagunex-baileys/issues"
  },
  "homepage": "https://github.com/remzzxelipsce/Kagunex-baileys#readme",
  "dependencies": {
    "pino": "^9.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "esbuild": "^0.24.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
